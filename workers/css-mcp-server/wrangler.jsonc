{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/schemas/config.json",

  "name": "css-mcp-server",
  "main": "src/index.ts",

  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],

  // KV namespace for OAuth token storage (used by @cloudflare/workers-oauth-provider)
  // The library requires the binding name to be "OAUTH_KV"
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "local-mcp-oauth-kv", "preview_id": "local-mcp-oauth-kv-preview" }
  ],

  // PCC-3192 — Rate Limiting bindings (red-team Finding 4).
  // Four bindings per env, each with a unique namespace_id so counters
  // do NOT collide ACROSS BINDINGS (within an env) and so the three envs
  // (local dev / staging / production) do NOT share counters either.
  //
  // Cloudflare's Rate Limiting namespaces are ACCOUNT-scoped: any two
  // bindings sharing a namespace_id share the same counters even across
  // different workers. So if staging AND production shared "3192100",
  // a CI load-test against staging from a runner IP would burn the prod
  // OAuth bucket for that same IP, and a runaway agent in prod would
  // poison the staging bucket. Disjoint per-env series prevents that:
  //   31923xx → top level (wrangler dev)
  //   31924xx → staging
  //   31922xx → production
  // The `'env-stanzas use disjoint namespace_id sets'` test guards this.
  // period must be 10 or 60 (Cloudflare API); standardised on 60.
  "ratelimits": [
    { "name": "RL_TOOLS_READ",     "namespace_id": "3192310", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_TOOLS_MUTATION", "namespace_id": "3192320", "simple": { "limit": 30,  "period": 60 } },
    { "name": "RL_OAUTH",          "namespace_id": "3192330", "simple": { "limit": 20,  "period": 60 } },
    { "name": "RL_TOOLS_ANON",     "namespace_id": "3192340", "simple": { "limit": 60,  "period": 60 } }
  ],

  // ============================================================================
  // Auth secrets (set via `wrangler secret put --env <env>`, never committed):
  //   AUTH0_CLIENT_SECRET      - fetched from GCP Secret Manager and set by deploy workflow
  //   MCP_STATE_SIGNING_SECRET - HMAC key for OAuth state signing (local to this worker)
  // Non-secret Auth0 vars (AUTH0_CLIENT_ID, AUTH0_ISSUER_BASE_URL, AUTH0_AUDIENCE)
  // are set per-environment in the vars blocks below, matching the main CSS worker.
  // ============================================================================

  // Non-secret environment variables
  "vars": {
    "ENVIRONMENT": "local",
    "LOG_LEVEL": "debug",
    "APP_VERSION": "dev",
    // Local ndjson log collector (`pnpm dev:logs`). Deliberately declared only here:
    // named environments below *replace* `vars` rather than merging, so staging and
    // production cannot inherit this — the sink is structurally unable to run in a
    // deployed worker rather than merely unset there.
    "P1_LOG_SINK": "http://127.0.0.1:8799",
    "CSS_BACKEND_URL": "http://localhost:8787",
    "MCP_SERVER_NAME": "collaborative-state-mcp",
    "MCP_SERVER_VERSION": "0.1.0",
    "PUBLIC_ORIGIN": "http://localhost:8788"
  },

  // Local development
  "dev": {
    "port": 8788,
    "local_protocol": "http",
    "ip": "0.0.0.0"
  },

  // Environment overrides
  "env": {
    "staging": {
      "name": "css-mcp-server-staging",
      "account_id": "69bc76f4866aaaa3400ea7fbbd9d7da2",
      "vars": {
        "ENVIRONMENT": "staging",
        "LOG_LEVEL": "info",
        "APP_VERSION": "staging",
        "CSS_BACKEND_URL": "https://collaborative-state-worker-staging.pantheon-content-publisher.workers.dev",
        "MCP_SERVER_NAME": "collaborative-state-mcp",
        "MCP_SERVER_VERSION": "0.1.0",
        "PUBLIC_ORIGIN": "https://staging.mcp.p1.pantheon.io",
        "AUTH0_CLIENT_ID": "8UmnrZACFs4LlsjK0ppCmyAXgZIChI9Q",
        "AUTH0_ISSUER_BASE_URL": "https://auth-staging.pantheon.io",
        "AUTH0_AUDIENCE": "https://staging.mcp.p1.pantheon.io"
      },
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "dc4d679e294d422d9c74c1266d44e2c5" }
      ],
      "services": [
        { "binding": "CSS_BACKEND", "service": "collaborative-state-worker-staging" }
      ],
      // PCC-3192 — Rate Limiting bindings. staging uses the 31924xx namespace
      // series — disjoint from production (31922xx) and local dev (31923xx)
      // so staging / prod buckets stay separate.
      "ratelimits": [
        { "name": "RL_TOOLS_READ",     "namespace_id": "3192410", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_TOOLS_MUTATION", "namespace_id": "3192420", "simple": { "limit": 30,  "period": 60 } },
        { "name": "RL_OAUTH",          "namespace_id": "3192430", "simple": { "limit": 20,  "period": 60 } },
        { "name": "RL_TOOLS_ANON",     "namespace_id": "3192440", "simple": { "limit": 60,  "period": 60 } }
      ],
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": false
        }
      }
    },
    "production": {
      "name": "css-mcp-server-production",
      "vars": {
        "ENVIRONMENT": "production",
        "LOG_LEVEL": "warn",
        "APP_VERSION": "production",
        "CSS_BACKEND_URL": "https://collaborative-state-worker-production.pantheon-p1-production.workers.dev",
        "MCP_SERVER_NAME": "collaborative-state-mcp",
        "MCP_SERVER_VERSION": "0.1.0",
        "PUBLIC_ORIGIN": "https://mcp.p1.pantheon.io",
        "AUTH0_CLIENT_ID": "W4yxx7nfVLAsqDA3fiAUBnGm2idEB8jW",
        "AUTH0_ISSUER_BASE_URL": "https://pantheon.auth0.com",
        "AUTH0_AUDIENCE": "https://mcp.p1.pantheon.io"
      },
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "c84425ba98ac4f2290d8e58a92c606d1" }
      ],
      // Service binding to the API worker — keeps the agent key on
      // Cloudflare's internal worker-to-worker path. Without this, api-client
      // falls back to global fetch() and X-API-Key transits the public
      // Internet (PCC-3193, red-team Finding 6).
      "services": [
        { "binding": "CSS_BACKEND", "service": "collaborative-state-worker-production" }
      ],
      // PCC-3192 — Rate Limiting bindings (red-team Finding 4). Re-declared
      // per-env (see top-level ratelimits comment for rationale). Production
      // uses the 31922xx namespace series — disjoint from staging (31924xx)
      // and dev (31923xx) so the three envs do NOT share counters.
      "ratelimits": [
        { "name": "RL_TOOLS_READ",     "namespace_id": "3192210", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_TOOLS_MUTATION", "namespace_id": "3192220", "simple": { "limit": 30,  "period": 60 } },
        { "name": "RL_OAUTH",          "namespace_id": "3192230", "simple": { "limit": 20,  "period": 60 } },
        { "name": "RL_TOOLS_ANON",     "namespace_id": "3192240", "simple": { "limit": 60,  "period": 60 } }
      ],
      // Workers Logs — same rationale as staging.
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": false
        }
      }
    }
  }
}
