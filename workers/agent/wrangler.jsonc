{
  "name": "p1-chatbot-agent",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_AGENT", "class_name": "ChatAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatAgent"] }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "local",
    "CSS_BACKEND_URL": "http://localhost:8787",
    // All model calls go through this AI Gateway's OpenAI-compatible endpoint.
    // Put CF_AIG_TOKEN in .env for local runs.
    "AI_GATEWAY_ACCOUNT_ID": "69bc76f4866aaaa3400ea7fbbd9d7da2",
    "AI_GATEWAY_NAME": "p1-chatbot",
    // Model in provider/model notation. workers-ai/@cf/... = native Cloudflare model
    // (billed via Workers AI, no gateway credits). Switch to anthropic/... once the
    // gateway holds an Anthropic credential.
    "AGENT_MODEL": "workers-ai/@cf/moonshotai/kimi-k2.7-code",
    "MEDIA_WORKER_URL": "https://p1-media.chris-801.workers.dev"
  },
  "env": {
    "sbx1": {
      "vars": {
        "ENVIRONMENT": "sbx1",
        "CSS_BACKEND_URL": "https://collaborative-state-worker-sbx1.chris-801.workers.dev",
        "AI_GATEWAY_ACCOUNT_ID": "69bc76f4866aaaa3400ea7fbbd9d7da2",
        "AI_GATEWAY_NAME": "p1-chatbot",
        "AGENT_MODEL": "workers-ai/@cf/moonshotai/kimi-k2.7-code",
        "MEDIA_WORKER_URL": "https://p1-media.chris-801.workers.dev"
      },
      "durable_objects": {
        "bindings": [
          { "name": "CHAT_AGENT", "class_name": "ChatAgent" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ChatAgent"] }
      ]
    },
    "staging": {
      "account_id": "69bc76f4866aaaa3400ea7fbbd9d7da2",
      "vars": {
        "ENVIRONMENT": "staging",
        "CSS_BACKEND_URL": "https://collaborative-state-worker-staging.pantheon-content-publisher.workers.dev",
        "AI_GATEWAY_ACCOUNT_ID": "69bc76f4866aaaa3400ea7fbbd9d7da2",
        "AI_GATEWAY_NAME": "p1-chatbot",
        "AGENT_MODEL": "workers-ai/@cf/moonshotai/kimi-k2.7-code",
        "MEDIA_WORKER_URL": "https://p1-media-worker-staging.pantheon-content-publisher.workers.dev"
      },
      "durable_objects": {
        "bindings": [
          { "name": "CHAT_AGENT", "class_name": "ChatAgent" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ChatAgent"] }
      ]
    }
  }
}
