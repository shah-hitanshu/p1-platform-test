# CCR MCP Server Configuration

# Backend URL (local development)
WORKER_API_URL=http://localhost:8787

# Agent credentials
# For local dev: use the mock agent below (no registration needed)
# For real keys: register an agent at http://localhost:5173/agents,
#   generate an API key (starts with aak_), and paste it here.
AGENT_ID=a0000000-0000-0000-0000-000000000001
AGENT_API_KEY=test-agent-key-zappy

# Optional: default site and branch for tool calls
DEFAULT_SITE_ID=site-123
DEFAULT_BRANCH_ID=main
