{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "allowArbitraryExtensions": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "src/__tests__", "src/__mocks__", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
