# Staging profile — used by `pnpm dev:starter:staging` at repo root
# (dotenv-cli injects these before the starter app starts).
# Copy this file to .env.staging.local (repo root) and fill in staging credentials.
NEXT_PUBLIC_CSS_BASE_URL=https://staging.ccr.p1.pantheon.io
# Deliberately blank: a profile must override every key .env.local might set,
# otherwise a mock auth-mode from .env.local would leak into the staging run.
NEXT_PUBLIC_CSS_AUTH_MODE=
NEXT_PUBLIC_CSS_SITE_ID=your-staging-site-id
CSS_API_KEY=your-staging-site-token
