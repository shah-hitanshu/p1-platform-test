{
  "name": "p1-platform",
  "version": "0.0.0",
  "private": true,
  "description": "P1 platform monorepo: collaborative state system, Puck CSS SDK, AI chat, and media",
  "scripts": {
    "dev:starter": "dotenv -e .env.fullstack.local -- pnpm --filter @pantheon-systems/p1-starter dev",
    "dev:css-frontend": "pnpm --filter css-frontend dev",
    "dev:agent": "pnpm --filter @p1/agent dev",
    "dev:media": "pnpm --filter p1-media-worker dev",
    "dev:mcp": "pnpm --filter css-mcp-server dev",
    "dev:stack": "make docker-up && dotenv -e .env.fullstack.local -- turbo run dev:stack",
    "dev:starter:staging": "dotenv -e .env.staging.local -- pnpm --filter @pantheon-systems/p1-starter dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "clean": "pnpm -r clean",
    "ci:version": "changeset version",
    "ci:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@pantheon-systems/eslint-config": "workspace:*",
    "@playwright/test": "^1.58.0",
    "@types/node": "^20.19.30",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.27.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.1",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "ws": "^8.21.0",
    "dotenv-cli": "^11.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
