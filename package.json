{
  "name": "puck-css-integration",
  "version": "0.0.1",
  "private": true,
  "description": "Puck editor integration with Collaborative State System",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "publish:packages": "pnpm build && pnpm -r publish --no-git-checks --access restricted"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^20.19.30",
    "@pantheon-systems/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.27.0",
    "prettier": "^3.8.1",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0",
      "minimatch": ">=10.2.5",
      "markdown-it": ">=14.1.1",
      "rollup": ">=4.59.0",
      "flatted": ">=3.4.2",
      "postcss": ">=8.5.10",
      "uuid": ">=14.0.0",
      "happy-dom": ">=20.8.9",
      "lodash": ">=4.18.0",
      "ajv": ">=6.14.0"
    }
  }
}
