{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "PCC_SITE_ID",
        "PCC_TOKEN",
        "NEXT_PUBLIC_CSS_BASE_URL",
        "NEXT_PUBLIC_CSS_SITE_ID",
        "NEXT_PUBLIC_CSS_BRANCH_ID",
        "CSS_API_KEY"
      ],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["NEXT_PUBLIC_*", "CSS_API_KEY", "PCC_SITE_ID", "PCC_TOKEN"]
    },
    "dev:stack": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["NEXT_PUBLIC_*", "CSS_API_KEY", "PCC_SITE_ID", "PCC_TOKEN"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "//#lint:root": {
      "inputs": ["scripts/**", "e2e/**", "eslint.config.js", "playwright.config.ts", "vitest.workspace.ts"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  },
  "globalDependencies": ["tsconfig.base.json", ".prettierrc"]
}
