{
  "name": "@pantheon-systems/create-p1-starter-kit",
  "version": "0.11.1",
  "description": "Scaffold a new P1 starter project",
  "type": "module",
  "bin": {
    "create-p1-starter-kit": "./index.js"
  },
  "scripts": {
    "build": "node scripts/build-template.js",
    "clean": "rm -rf template node_modules/.vite",
    "lint": "eslint index.js lib scripts",
    "lint:fix": "eslint index.js lib scripts --fix",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "files": [
    "index.js",
    "lib/",
    "template/"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pantheon-systems/p1-platform.git",
    "directory": "packages/create-p1-starter-kit"
  },
  "keywords": [
    "p1",
    "puck",
    "cms",
    "content-publisher",
    "starter",
    "template"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@pantheon-systems/css-client": "workspace:*",
    "@pantheon-systems/eslint-config": "workspace:*",
    "@pantheon-systems/puck-css": "workspace:*",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.27.0",
    "isomorphic-dompurify": "^3.18.0",
    "react": "^19.2.5",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "picocolors": "^1.1.1"
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/pantheon-systems/p1-platform/tree/main/packages/create-p1-starter-kit"
}
