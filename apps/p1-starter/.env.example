PCC_SITE_ID=your-site-id
PCC_TOKEN=your-token

# --- API backend (required) ---
P1_CSS_BASE_URL=https://css.example.com
P1_CSS_API_KEY=your-api-key
P1_CSS_SITE_ID=site-123

# Branch is auto-detected (defaults to main) unless specified:
# P1_CSS_BRANCH_ID=branch-456

# --- Client-side CSS config (used by CSSApp editor) ---
# These NEXT_PUBLIC_ vars are read by the browser for the collaborative editor.
NEXT_PUBLIC_CSS_BASE_URL=https://css.example.com
NEXT_PUBLIC_CSS_SITE_ID=site-123
# NEXT_PUBLIC_CSS_AUTH_MODE=p1
