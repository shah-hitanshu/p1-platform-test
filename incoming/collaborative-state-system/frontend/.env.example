# Frontend Environment Variables
#
# For local development with Vite dev proxy, these are not needed.
# For deployed frontends (e.g. Cloudflare Pages), set VITE_API_BASE_URL
# to the Worker API URL.

# API base URL — prefix for all API requests
# Leave empty or unset for local development (Vite proxy handles routing)
# Example: https://collaborative-state-worker-sandbox.your-account.workers.dev
# VITE_API_BASE_URL=

# --- OAuth Provider Configuration ---
# Configure one or more providers to enable real authentication.
# When no OAuth providers are configured, mock login is enabled by default.

# Google OAuth (optional — enables "Sign in with Google" button)
# Create credentials at https://console.cloud.google.com/apis/credentials
#
# IMPORTANT: When deploying the frontend Worker, add its URL to
# "Authorized JavaScript origins" in Google Cloud Console:
#   - sbx1: https://collaborative-state-frontend-sbx1.chris-801.workers.dev
#   - prod: (your production frontend URL)
#
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Auth0 (optional — enables "Log in with Auth0" button)
# Both domain and client ID are required to enable Auth0.
# VITE_AUTH0_DOMAIN=your-tenant.auth0.com
# VITE_AUTH0_CLIENT_ID=your-auth0-client-id
# VITE_AUTH0_AUDIENCE=https://your-api-identifier

# Mock login (defaults to enabled when no OAuth providers are configured)
# Set to "true" to keep mock login available alongside OAuth providers.
# VITE_ENABLE_MOCK_LOGIN=true
