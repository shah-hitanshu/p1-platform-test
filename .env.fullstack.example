# Full local stack profile — used by `pnpm dev:stack` at repo root
# (runs the starter app via `dotenv -e .env.fullstack.local -- next dev`).
# Copy this file to .env.fullstack.local (repo root) and fill in your local site values.
NEXT_PUBLIC_CSS_BASE_URL=http://localhost:8787
NEXT_PUBLIC_CSS_AUTH_MODE=mock
NEXT_PUBLIC_CSS_SITE_ID=your-local-site-id
CSS_API_KEY=your-local-site-token
