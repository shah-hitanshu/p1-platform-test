{
  "name": "@pantheon-systems/p1-next-sdk",
  "version": "0.4.2",
  "description": "Next.js SDK for P1 editor integration",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pantheon-systems/puck-css-integration.git",
    "directory": "packages/p1-next-sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@pantheon-systems/puck-css": "workspace:*",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "@puckeditor/core": ">=0.21.0",
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@pantheon-systems/eslint-config": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "eslint": "^9.27.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
