{
  "name": "@pantheon/puck-css",
  "version": "0.3.1",
  "description": "Puck editor integration with Collaborative State System",
  "repository": {
    "type": "git",
    "url": "https://github.com/pantheon-systems/puck-css-integration.git",
    "directory": "packages/puck-css"
  },
  "publishConfig": {
    "@pantheon:registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "config": [
        "./dist/config.d.ts"
      ],
      "utils/path": [
        "./dist/utils/path.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config.js",
      "types": "./dist/config.d.ts"
    },
    "./utils/path": {
      "import": "./dist/utils/path.js",
      "types": "./dist/utils/path.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && cp src/styles.css dist/styles.css",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pantheon/css-client": "workspace:*",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^24.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "@puckeditor/core": ">=0.21.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
