# CSS API Configuration
# Uses JWT authentication - token obtained via /api/auth/token endpoint
VITE_CSS_BASE_URL=http://localhost:8787

# Site and Branch Configuration
VITE_CSS_SITE_ID=your-site-id

# Branch ID (optional - defaults to main branch if not set)
# VITE_CSS_BRANCH_ID=your-branch-id

# Auth mode: 'mock' (default), 'google', or 'auth0'
VITE_AUTH_MODE=mock

# Google OAuth (when VITE_AUTH_MODE=google)
VITE_GOOGLE_CLIENT_ID=

# Auth0 (when VITE_AUTH_MODE=auth0)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
