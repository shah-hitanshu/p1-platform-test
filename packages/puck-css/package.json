{
  "name": "@pantheon-systems/puck-css",
  "version": "0.16.0",
  "description": "Puck editor integration with Pantheon's P1 content platform",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pantheon-systems/p1-platform.git",
    "directory": "packages/puck-css"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "config": [
        "./dist/config.d.ts"
      ],
      "utils/path": [
        "./dist/utils/path.d.ts"
      ],
      "pds": [
        "./dist/pds/index.d.ts"
      ],
      "fields": [
        "./dist/data/fields.d.ts"
      ],
      "media-fields": [
        "./dist/data/media-field-name.d.ts"
      ],
      "sanitize-richtext": [
        "./dist/data/sanitize-richtext.d.ts"
      ],
      "seo": [
        "./dist/data/page-metadata/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./utils/path": {
      "types": "./dist/utils/path.d.ts",
      "import": "./dist/utils/path.js",
      "default": "./dist/utils/path.js"
    },
    "./styles.css": "./src/styles.css",
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./registry-sync": {
      "types": "./dist/registry-sync.d.ts",
      "import": "./dist/registry-sync.js",
      "default": "./dist/registry-sync.js"
    },
    "./auth-gate": {
      "types": "./dist/auth/AuthGate.d.ts",
      "import": "./dist/auth/AuthGate.js",
      "default": "./dist/auth/AuthGate.js"
    },
    "./connectable": {
      "types": "./dist/editor/components/connectable.d.ts",
      "import": "./dist/editor/components/connectable.js",
      "default": "./dist/editor/components/connectable.js"
    },
    "./pds": {
      "types": "./dist/pds/index.d.ts",
      "import": "./dist/pds/index.js",
      "default": "./dist/pds/index.js"
    },
    "./pds/styles.css": "./src/pds/theme/PuckEditorTheme.css",
    "./seo": {
      "types": "./dist/data/page-metadata/index.d.ts",
      "import": "./dist/data/page-metadata/index.js",
      "default": "./dist/data/page-metadata/index.js"
    },
    "./sanitize-richtext": {
      "types": "./dist/data/sanitize-richtext.d.ts",
      "import": "./dist/data/sanitize-richtext.js",
      "default": "./dist/data/sanitize-richtext.js"
    },
    "./fields": {
      "types": "./dist/data/fields.d.ts",
      "import": "./dist/data/fields.js",
      "default": "./dist/data/fields.js"
    },
    "./media-fields": {
      "types": "./dist/data/media-field-name.d.ts",
      "import": "./dist/data/media-field-name.js",
      "default": "./dist/data/media-field-name.js"
    },
    "./routes": {
      "types": "./dist/data/route-templates.d.ts",
      "import": "./dist/data/route-templates.js",
      "default": "./dist/data/route-templates.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.css",
    "!src/**/*.module.css",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json --emitDeclarationOnly --declarationMap false && tsc -p tsconfig.build.json --declaration false --declarationMap false --sourceMap false --removeComments && find src \\( -name '*.module.css' -o \\( -path 'src/data/*' -name '*.css' \\) \\) | while read f; do dest=\"dist/${f#src/}\"; mkdir -p \"$(dirname \"$dest\")\"; cp \"$f\" \"$dest\"; done; (cp node_modules/@pantheon-systems/pds-toolkit-react/dist/css/pds-core.css src/pds/theme/pds-core.css && node scripts/generate-pds-content.cjs) || true",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "vite --config vite.config.preview.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:spike:3406": "vitest run --config spike/pcc-3406/vitest.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:tests": "tsc --noEmit"
  },
  "dependencies": {
    "@pantheon-systems/css-client": "workspace:*",
    "fast-json-patch": "^3.1.1",
    "isomorphic-dompurify": "^3.18.0",
    "jsep": "^1.4.0",
    "lodash.isequal": "^4.5.0",
    "yjs": "^13.6.29"
  },
  "devDependencies": {
    "@floating-ui/react": "^0.27.19",
    "@pantheon-systems/eslint-config": "workspace:*",
    "@pantheon-systems/pds-toolkit-react": "2.0.0-alpha.87",
    "@tanstack/react-query": "^5.99.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/lodash.isequal": "^4.5.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^24.1.3",
    "react-toastify": "^11.0.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@pantheon-systems/pds-toolkit-react": ">=2.0.0-alpha.86",
    "@puckeditor/core": ">=0.21.0",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/pantheon-systems/p1-platform/tree/main/packages/puck-css"
}
