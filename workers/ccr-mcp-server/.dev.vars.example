# MCP Server Development Secrets
# Copy to .dev.vars and fill in values

# Auth0 application credentials for the upstream sign-in flow.
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-api-audience

# HMAC key for signing the OAuth state parameter. Any high-entropy random string.
MCP_STATE_SIGNING_SECRET=generate-a-random-32-byte-hex-string
