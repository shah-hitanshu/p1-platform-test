{
  "name": "css-mcp-server",
  "version": "0.1.0",
  "description": "Remote MCP server for Collaborative State System with OAuth 2.0 authentication",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:sandbox": "wrangler deploy --env sandbox",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pantheon-systems/p1-content-validator": "workspace:*",
    "jose": "^6.2.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260515.1",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.92.0"
  },
  "pnpm": {
    "overrides": {
      "wrangler>path-to-regexp": "^8.4.0"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
