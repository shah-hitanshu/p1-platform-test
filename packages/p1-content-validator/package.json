{
  "name": "@pantheon-systems/p1-content-validator",
  "version": "1.0.0",
  "description": "Validates Puck component edit operations against the CSS component registry",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
