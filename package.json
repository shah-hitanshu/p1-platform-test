{
  "name": "puck-css-integration",
  "version": "0.0.1",
  "private": true,
  "description": "Puck editor integration with Collaborative State System",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "publish:packages": "pnpm build && pnpm -r publish --no-git-checks --access restricted"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0",
      "minimatch": ">=10.2.3",
      "markdown-it": ">=14.1.1",
      "rollup": ">=4.59.0"
    }
  }
}
