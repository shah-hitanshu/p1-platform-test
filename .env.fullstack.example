# Full local stack profile — used by `pnpm dev:stack` and `pnpm dev:starter`
# at repo root (dotenv-cli injects these before the dev servers start).
# Copy this file to .env.fullstack.local (repo root) and fill in your local site values.
NEXT_PUBLIC_CSS_BASE_URL=http://localhost:8787
NEXT_PUBLIC_CSS_AUTH_MODE=mock
NEXT_PUBLIC_CSS_SITE_ID=your-local-site-id
CSS_API_KEY=your-local-site-token

# The agent worker runs on :8790 and needs secrets in workers/p1-agent/.env.
# Keep this set: unset resolves to the production agent, so a local editor
# would hold threads against production rather than against your stack.
NEXT_PUBLIC_AGENT_URL=http://localhost:8790

# Browser feature flags answered locally, instead of by LaunchDarkly: a comma-separated
# list of flag keys, or a JSON object of flag key to boolean if you need to force one off.
# `pnpm dev:stack -- --flags=<key>` sets this for one run and checks the spelling first.
# Read only outside a production build, and it moves the client alone — a flag forced on
# here against a staging backend offers what that backend will refuse.
# NEXT_PUBLIC_P1_FLAG_OVERRIDES=p1-collaboration
