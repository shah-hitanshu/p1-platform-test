{
  // What ships: src only, tests carved out. `build` and `typecheck` run this.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/__tests__", "src/__mocks__", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
