{
  "name": "@pantheon-systems/css-client",
  "version": "0.13.0",
  "description": "TypeScript API client for Pantheon's P1 content platform",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pantheon-systems/p1-platform.git",
    "directory": "packages/css-client"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./content": {
      "import": "./dist/content.js",
      "types": "./dist/content.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "content": [
        "./dist/content.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "sync-version": "node scripts/sync-sdk-version.mjs",
    "prebuild": "node scripts/sync-sdk-version.mjs",
    "build": "pnpm run clean && tsc --emitDeclarationOnly && tsc --declaration false --declarationMap false --removeComments",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@pantheon-systems/eslint-config": "workspace:*",
    "@types/node": "^20.19.30",
    "eslint": "^9.27.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "partysocket": "1.1.10",
    "yjs": "^13.6.29"
  },
  "homepage": "https://github.com/pantheon-systems/p1-platform/tree/main/packages/css-client"
}
