{
  "name": "ccr-worker",
  "version": "0.0.0",
  "description": "Cloudflare Workers infrastructure for collaborative content repository",
  "private": true,
  "type": "module",
  "scripts": {
    "cleanup:dev": "pkill -9 -f 'wrangler.*dev.*--local' 2>/dev/null; pkill -9 -f 'workerd.*serve' 2>/dev/null; true",
    "cleanup:test": "pkill -9 -f 'vitest' 2>/dev/null || true",
    "cleanup:all": "pnpm cleanup:dev && pnpm cleanup:test",
    "predev": "pnpm cleanup:dev",
    "dev": "wrangler dev --local",
    "dev:stack": "wrangler dev --local --inspector-port 9229",
    "dev:watch": "node scripts/dev-watch.js",
    "dev:remote": "wrangler dev",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run && vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:typecheck": "vitest --typecheck.only",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:status": "tsx src/db/migrate.ts --status",
    "db:migrate:reset": "tsx src/db/migrate.ts --reset",
    "db:cleanup": "tsx src/db/cleanup-test-data.ts",
    "db:cleanup:execute": "tsx src/db/cleanup-test-data.ts --execute",
    "db:backfill-template-content-shape": "tsx src/db/backfill-template-content-shape.ts",
    "db:backfill-template-content-shape:execute": "tsx src/db/backfill-template-content-shape.ts --execute",
    "db:adopt-slot-ids": "tsx src/db/adopt-slot-ids.ts",
    "db:adopt-slot-ids:execute": "tsx src/db/adopt-slot-ids.ts --execute",
    "db:backfill-page-titles": "tsx src/db/backfill-page-titles.ts",
    "db:backfill-page-titles:execute": "tsx src/db/backfill-page-titles.ts --execute",
    "db:repair-published-snapshots": "tsx src/db/repair-published-snapshots.ts",
    "db:repair-published-snapshots:execute": "tsx src/db/repair-published-snapshots.ts --execute",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "cf:tail": "wrangler tail",
    "cf:kv:list": "wrangler kv:key list --binding CONFIG_KV"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.3.0",
    "@pantheon-systems/p1-content-validator": "workspace:*",
    "@pantheon-systems/p1-telemetry": "workspace:*",
    "ajv": "^8.18.0",
    "aws4fetch": "^1.0.20",
    "fast-json-patch": "^3.1.1",
    "fflate": "^0.8.2",
    "jose": "^5.10.0",
    "object-hash": "^3.0.0",
    "p-limit": "^7.3.0",
    "postgres": "^3.4.8",
    "yjs": "^13.6.29",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260515.1",
    "@eslint/js": "^9.39.3",
    "@pantheon-systems/eslint-config": "workspace:*",
    "@types/node": "^22.19.13",
    "@types/object-hash": "^3.0.6",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9.39.3",
    "fast-check": "^3.22.0",
    "globals": "^15.15.0",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.107.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
