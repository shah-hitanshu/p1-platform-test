{
  "name": "collaborative-state-mcp",
  "version": "0.1.0",
  "description": "MCP server for Collaborative State System - enables Claude Desktop to edit documents via Agent Politeness workflow",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "collaborative-state-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "typecheck": "tsc --noEmit",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "overrides": {
      "hono": ">=4.11.10",
      "minimatch": ">=10.2.1",
      "qs": ">=6.14.2",
      "esbuild": ">=0.25.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^22.19.13",
    "eslint": "^9.39.3",
    "globals": "^15.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
