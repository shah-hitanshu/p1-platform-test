{
  "name": "@pantheon-systems/p1-registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "pnpm --filter @pantheon-systems/p1-starter-components registry:build && next build",
    "clean": "rm -rf .next out public/r *.tsbuildinfo",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pantheon-systems/p1-starter-components": "workspace:*",
    "next": "^16.2.12",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@pantheon-systems/eslint-config": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.27.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
